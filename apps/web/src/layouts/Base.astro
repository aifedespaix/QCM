---
import { QcmLogo } from '@qcm/ui'
import HeaderControls from '../components/HeaderControls.vue'
import MobileMenus from '../components/MobileMenus.vue'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  /** Classe ajoutée à <body> (fond décoratif de l'accueil). */
  bodyClass?: string
}

const {
  title,
  description = 'QCM : des questionnaires calmes, sans publicité, sans chronomètre.',
  bodyClass = '',
} = Astro.props
const path = Astro.url.pathname
const links = [
  { href: '/bibliotheque', label: 'Bibliothèque' },
  { href: '/editeur', label: 'Créer un QCM' },
  { href: '/statistiques', label: 'Suivi' },
]
const current = (active: boolean) => (active ? 'page' : undefined)
// Une fiche de QCM fait partie de la bibliothèque.
const inLibrary = path.startsWith('/bibliotheque') || path.startsWith('/qcm')
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · QCM</title>
    <script is:inline>
      // Applique le thème enregistré avant le premier affichage (pas de flash).
      try {
        const stored = localStorage.getItem('qcm:theme')
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
      } catch {}
    </script>
    <script is:inline>
      // Reprise après une coupure : si le code d'une page ne se charge pas (réseau instable), on recharge
      // une fois automatiquement, puis on propose un bouton si l'îlot reste vide.
      (function () {
        var KEY = 'qcm:chunk-reload'
        function reloadOnce() {
          try {
            var last = Number(sessionStorage.getItem(KEY) || 0)
            if (Date.now() - last < 15000) return false
            sessionStorage.setItem(KEY, String(Date.now()))
          } catch (e) {}
          location.reload()
          return true
        }
        window.addEventListener('vite:preloadError', function (event) {
          if (reloadOnce()) event.preventDefault()
        })
        function showBanner() {
          if (document.getElementById('qcm-load-failed')) return
          var bar = document.createElement('div')
          bar.id = 'qcm-load-failed'
          bar.setAttribute('role', 'alert')
          bar.style.cssText = 'position:fixed;inset:auto 12px calc(var(--site-tabbar,0px) + 12px) 12px;z-index:100;display:flex;gap:12px;align-items:center;justify-content:space-between;padding:12px 16px;border:2px solid currentColor;border-radius:16px;background:#fff8e1;color:#222;font-weight:700'
          bar.innerHTML = '<span>La page n\u2019a pas fini de se charger.</span>'
          var button = document.createElement('button')
          button.type = 'button'
          button.textContent = 'Recharger'
          button.style.cssText = 'min-height:44px;padding:0 16px;border:2px solid currentColor;border-radius:12px;background:#fff;font:inherit;cursor:pointer'
          button.onclick = function () { location.reload() }
          bar.appendChild(button)
          document.body.appendChild(bar)
        }
        function check() {
          // Un îlot « client:only » garde l'attribut ssr tant qu'il n'est pas monté.
          if (document.querySelector('astro-island[ssr]')) showBanner()
        }
        window.addEventListener('load', function () { setTimeout(check, 6000) })
        window.addEventListener('online', function () {
          if (document.querySelector('astro-island[ssr]')) location.reload()
        })
      })()
    </script>
  </head>
  <body class:list={['site-body flex min-h-dvh flex-col bg-bg text-ink', bodyClass]}>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-xl focus:bg-surface focus:p-3">
      Aller au contenu
    </a>
    <!-- Bandeau : une seule ligne, toujours collée en haut. Sur téléphone, la navigation est dans la barre du bas. -->
    <header class="site-header sticky top-0 z-40 border-b-[1.5px] border-line-soft bg-bg/85 backdrop-blur-md">
      <div class="site-shell flex h-full items-center justify-between gap-x-4">
        <div class="flex items-center gap-x-6">
          <a href="/" class="site-brand" aria-label="QCM, accueil">
            <QcmLogo size={48} />
            <span class="flex flex-col">
              <span class="site-brand-name">QCM</span>
              <span class="site-brand-tagline">Réviser au calme</span>
            </span>
          </a>
          <nav aria-label="Navigation principale" class="hidden items-center gap-1 lg:flex">
            {
              links.map((link) => (
                <a href={link.href} class="site-nav-link" aria-current={current(link.href === '/bibliotheque' ? inLibrary : path.startsWith(link.href))}>
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="hidden lg:block">
          <HeaderControls client:only="vue" />
        </div>
      </div>
    </header>

    <main id="contenu" class="site-shell flex-1 pt-5 pb-12 sm:pt-8 sm:pb-20">
      <slot />
    </main>

    <footer class="border-t-[1.5px] border-line-soft bg-surface/60">
      <div class="site-shell flex flex-col gap-6 py-8 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-sm">
          <p class="flex items-center gap-2.5 text-2xl font-extrabold tracking-tight">
            <QcmLogo size={36} />
            QCM
          </p>
          <p class="mt-2 text-sm text-ink-soft">Des questionnaires calmes pour réviser à son rythme. Logiciel libre, sans publicité et sans pistage.</p>
        </div>
        <nav aria-label="Liens de pied de page" class="flex flex-col gap-1 text-sm font-bold">
          <a href="/bibliotheque" class="hover:underline">Bibliothèque</a>
          <a href="/editeur" class="hover:underline">Créer un QCM</a>
          <a href="/statistiques" class="hover:underline">Suivi des révisions</a>
          <a href="/#telecharger" class="hover:underline">Télécharger le lecteur Windows</a>
        </nav>
      </div>
    </footer>

    <!-- Barre du bas (téléphone, tablette) : sous le pouce, avec la bibliothèque au centre. -->
    <nav aria-label="Navigation principale" class="site-tabbar lg:hidden">
      <div class="site-tabbar-inner">
        <a href="/" class="site-tab" aria-current={current(path === '/')}>
          <span class="site-tab-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11l8-7 8 7M6 9.5V20h4.2v-5.5h3.6V20H18V9.5" /></svg>
          </span>
          Accueil
        </a>
        <a href="/editeur" class="site-tab" aria-current={current(path.startsWith('/editeur'))}>
          <span class="site-tab-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1-4.5L16.5 4l3.5 3.5L8.5 19 4 20zM14 6.5l3.5 3.5" /></svg>
          </span>
          Créer
        </a>
        <a href="/bibliotheque" class="site-tab site-tab-main" aria-current={current(inLibrary)}>
          <span class="site-tab-disc">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.5C10 5 7 4.5 4 5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5V5c-3-.5-6 0-8 1.5zM12 6.5v13" /></svg>
          </span>
          Bibliothèque
        </a>
        <MobileMenus client:only="vue">
          <Fragment slot="fallback">
            <span class="site-tab" aria-hidden="true"><span class="site-tab-icon"></span>Réglages</span>
            <span class="site-tab" aria-hidden="true"><span class="site-tab-icon"></span>Compte</span>
          </Fragment>
        </MobileMenus>
      </div>
    </nav>
  </body>
</html>
