---
import { QcmLogo } from '@qcm/ui'
import HeaderControls from '../components/HeaderControls.vue'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  /** Classe ajoutée à <body> (fond décoratif de l'accueil). */
  bodyClass?: string
}

const {
  title,
  description = 'QCM : des questionnaires calmes, sans publicité, sans chronomètre.',
  bodyClass = '',
} = Astro.props
const links = [
  { href: '/bibliotheque', label: 'Bibliothèque' },
  { href: '/editeur', label: 'Créer un QCM' },
]
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · QCM</title>
    <script is:inline>
      // Applique le thème enregistré avant le premier affichage (pas de flash).
      try {
        const stored = localStorage.getItem('qcm:theme')
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
      } catch {}
    </script>
  </head>
  <body class:list={['flex min-h-dvh flex-col bg-bg text-ink', bodyClass]}>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-xl focus:bg-surface focus:p-3">
      Aller au contenu
    </a>
    <header class="top-0 z-40 border-b-[1.5px] border-line-soft bg-bg/85 backdrop-blur-md lg:sticky">
      <div class="site-shell flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-2.5">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href="/" class="site-brand" aria-label="QCM, accueil">
            <QcmLogo size={48} />
            <span class="flex flex-col">
              <span class="site-brand-name">QCM</span>
              <span class="site-brand-tagline">Réviser au calme</span>
            </span>
          </a>
          <nav aria-label="Navigation principale" class="flex flex-wrap items-center gap-1">
            {
              links.map((link) => (
                <a href={link.href} class="site-nav-link" aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
        <HeaderControls client:only="vue" />
      </div>
    </header>

    <main id="contenu" class="site-shell flex-1 pt-8 pb-20">
      <slot />
    </main>

    <footer class="border-t-[1.5px] border-line-soft bg-surface/60">
      <div class="site-shell flex flex-col gap-6 py-8 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-sm">
          <p class="flex items-center gap-2.5 text-2xl font-extrabold tracking-tight">
            <QcmLogo size={36} />
            QCM
          </p>
          <p class="mt-2 text-sm text-ink-soft">Des questionnaires calmes pour réviser à son rythme. Logiciel libre, sans publicité et sans pistage.</p>
        </div>
        <nav aria-label="Liens de pied de page" class="flex flex-col gap-1 text-sm font-bold">
          <a href="/bibliotheque" class="hover:underline">Bibliothèque</a>
          <a href="/editeur" class="hover:underline">Créer un QCM</a>
          <a href="/#telecharger" class="hover:underline">Télécharger le lecteur Windows</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
