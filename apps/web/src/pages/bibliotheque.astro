---
import LibraryBrowser from '../components/LibraryBrowser.vue'
import Base from '../layouts/Base.astro'
---

<Base title="Bibliothèque" description="Des QCM partagés par la communauté, à télécharger ou à essayer en ligne.">
  <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold sm:text-4xl">Bibliothèque</h1>
      <p class="mt-1 text-lg text-ink-soft">Des QCM relus avant publication, à essayer en ligne ou à télécharger.</p>
    </div>
    <a href="/editeur" class="qcm-block qcm-block-quiet qcm-block-sm no-underline">+ Proposer un QCM</a>
  </header>
  <LibraryBrowser client:only="vue" />
</Base>
