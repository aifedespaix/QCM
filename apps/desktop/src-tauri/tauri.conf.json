{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QCM",
  "version": "0.1.0",
  "identifier": "org.qcm.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QCM",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: qcm: http://qcm.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Lecteur de QCM hors-ligne",
    "longDescription": "QCM ouvre les fichiers .qcm et permet de réviser au calme, sans connexion, sans publicité et sans chronomètre.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["qcm"],
        "name": "QCM",
        "description": "Questionnaire QCM",
        "mimeType": "application/x-qcm",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REMPLACER_PAR_LA_CLE_PUBLIQUE",
      "endpoints": ["https://github.com/aifedespaix/qcm/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
